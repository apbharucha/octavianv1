# Copy this file to .env and fill with real values.
# Do NOT commit .env.

# --- Market data providers (all optional; the platform falls back gracefully) ---
# FINRA OTC Transparency API key (free registration: https://developer.finra.org).
# Used by the Dark Pool Intelligence dashboard for authoritative off-exchange
# volume. Can also be set in-app via Settings > FINRA OTC API key (stored in
# dark_pool_state.json, which is gitignored).
FINRA_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_KEY=
OANDA_API_KEY=
OANDA_BASE_URL=https://api-fxpractice.oanda.com
MASSIVE_API_KEY=
EODHD_API_KEY=

# --- Flask API backend security (REQUIRED in production) ---
# Long, random string used to sign Flask sessions. If unset, an ephemeral
# random key is generated at startup (sessions reset on restart).
SECRET_KEY=
# Optional shared bearer token required by protected backend endpoints.
API_BACKEND_KEY=
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
