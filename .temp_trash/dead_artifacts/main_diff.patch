+        if st.button("Open Terms of Service", key="goto_tos_gate"):
+            st.session_state["_nav_override"] = "Terms of Service"
+            st.rerun()
+    with col_b:
+        st.caption("Acceptance is stored permanently once acknowledged.")
+    return False
