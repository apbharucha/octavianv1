+def _require_tos_acknowledgment(selected_page: str) -> bool:
+    """
+    Guard for sensitive pages. ToS acceptance is stored permanently in the DB
+    at registration, so `tos_acknowledged` is set in session_state on login
+    (see auth_engine.authenticate_user). This function only blocks if, for
+    some reason, the flag is missing (e.g. a pre-migration legacy account).
+    In that case we direct the user to the Terms of Service page to accept.
+    """
+    sensitive_pages = {
+        "Paper Trading",
+        "Position Optimizer",
+        "Portfolio Analyzer",
+        "Quant Portal",
+        "Strategy Research Lab",
+        "Document Analyzer",
+        "Simulation Hub",
+    }
+    if selected_page not in sensitive_pages:
+        return True
+    if st.session_state.get("tos_acknowledged", False):
+        return True
+
+    # Legacy / un-migrated account: prompt to accept once from the ToS page
+    st.warning(
+        f"Please review and acknowledge the Terms of Service before using **{selected_page}**."
+    )
+    col_a, col_b = st.columns([1, 1])
